# TrendBlogo Environment Configuration
APP_NAME=TrendBlogo
APP_ENV=development
APP_SECRET=trendblogo-super-secret-key-change-in-production-2026
BASE_URL=http://localhost:8000
DATABASE_URL=sqlite:///./trendblogo.db

# Admin Credentials (Initial Setup)
ADMIN_EMAIL=admin@trendblogo.com
ADMIN_PASSWORD=Admin123!

# AI Model Configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
IMAGE_GENERATION_PROVIDER=auto
DALL_E_MODEL=dall-e-3

# Automation & Safety Defaults
MAX_DAILY_GENERATIONS=100
DEFAULT_WORD_COUNT=1500
ENABLE_QUALITY_CONTROL=true
AUTO_SCHEDULE_INTERVAL_HOURS=6
